.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0;
  z-index: 30;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(13, 95, 212, 0.12);
  box-shadow: 0 -8rpx 24rpx rgba(13, 95, 212, 0.08);
}

.tabbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  width: 100%;
  padding: 8rpx 20rpx calc(8rpx + env(safe-area-inset-bottom));
  border-radius: 0;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24rpx);
  position: relative;
}

.tabbar__group {
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-evenly;
  gap: 8rpx;
}

.tabbar__group--left {
  padding-right: 84rpx;
}

.tabbar__group--right {
  padding-left: 84rpx;
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.tabbar__sticker {
  width: 92rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #eff6ff 0%, #d8e8ff 100%);
  border: 1rpx solid rgba(13, 95, 212, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.tabbar__sticker--active {
  background: linear-gradient(145deg, #1b74ee 0%, #0d5fd4 100%);
  box-shadow: 0 12rpx 24rpx rgba(13, 95, 212, 0.18);
}

.tabbar__sticker-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #0d5fd4;
  letter-spacing: 1rpx;
}

.tabbar__sticker--active .tabbar__sticker-text {
  color: #ffffff;
}

.tabbar__badge {
  position: absolute;
  left: 50%;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(13, 95, 212, 0.12);
  border: 1rpx solid rgba(13, 95, 212, 0.08);
  overflow: hidden;
}

.tabbar__badge-image {
  width: 112rpx;
  height: 112rpx;
  display: block;
}
