.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 30;
}

.tabbar {
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  padding: 18rpx 16rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(24rpx);
}

.tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tabbar__sticker {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #eff6ff 0%, #d8e8ff 100%);
  border: 1rpx solid rgba(13, 95, 212, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.tabbar__sticker--active {
  background: linear-gradient(145deg, #1b74ee 0%, #0d5fd4 100%);
  box-shadow: 0 12rpx 24rpx rgba(13, 95, 212, 0.18);
}

.tabbar__sticker-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0d5fd4;
}

.tabbar__sticker--active .tabbar__sticker-text {
  color: #ffffff;
}

.tabbar__label {
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.tabbar__label--active {
  color: var(--theme-primary);
  font-weight: 600;
}
