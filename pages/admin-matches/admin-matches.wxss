.admin-shell {
  padding-bottom: 48rpx;
}

.matches-toolbar {
  padding: 24rpx;
}

.toolbar-label {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.admin-event-tabs {
  margin-top: 14rpx;
  white-space: nowrap;
  height: 78rpx;
  width: 100%;
}

.admin-event-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 74rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.08);
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  vertical-align: top;
  flex-shrink: 0;
}

.admin-event-tab--active {
  background: var(--theme-primary);
  color: #ffffff;
}

.toolbar-action {
  height: 84rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.stage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.stage-card {
  padding: 28rpx;
}

.stage-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.match-admin-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.match-admin-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.08);
}

.match-admin-item__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.match-admin-item__teams {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  color: var(--theme-text);
}

.match-admin-item__edit {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.match-admin-item__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(9, 32, 61, 0.45);
  display: flex;
  align-items: flex-end;
  width: 100vw;
  max-width: 100vw;
}

.editor-sheet {
  width: 100%;
  max-width: 100vw;
  height: 84vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.editor-form-shell {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.editor-sheet__handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d8e3f2;
  flex: none;
}

.editor-scroll {
  flex: 1;
  min-height: 0;
}

.editor-head {
  margin-bottom: 18rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.form-field {
  margin-top: 18rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.field-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.stage-preset-wrap {
  margin-top: 12rpx;
}

.stage-preset-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.stage-preset {
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eef4fb;
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.stage-preset--active {
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 12rpx;
  min-height: 84rpx;
  height: 84rpx;
  padding: 0 20rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  color: var(--theme-text);
  box-sizing: border-box;
}

.form-input--picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.form-input__text {
  flex: 1;
  min-width: 0;
}

.form-input__arrow {
  flex: none;
  color: var(--theme-text-secondary);
  font-size: 24rpx;
}

.form-textarea {
  min-height: 240rpx;
  height: auto;
  padding: 20rpx;
  line-height: 1.7;
}

.form-textarea--compact {
  min-height: 180rpx;
}

.picker-detail {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.form-readonly {
  width: 100%;
  margin-top: 12rpx;
  min-height: 84rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--theme-text);
  box-sizing: border-box;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.editor-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.editor-btn--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}

.editor-btn--primary {
  background: var(--theme-primary);
  color: #ffffff;
}

.form-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.mini-action {
  flex: 1;
  min-height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.mini-action--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}
