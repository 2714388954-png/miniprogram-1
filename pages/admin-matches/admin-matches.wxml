<app-nav-bar title="比赛管理" back="{{false}}" color="#15314b" background="transparent"></app-nav-bar>
<scroll-view class="page-scroll" scroll-y>
  <view class="page-shell page-shell--safe admin-shell">
    <view class="page-top-actions">
      <view class="page-back-btn" bindtap="handleBack">返回</view>
      <view class="top-actions-group">
        <view class="top-mini-action" bindtap="openEventEditor">编辑赛事</view>
        <view class="top-mini-action" bindtap="openCreateEventForm">新增赛事</view>
      </view>
    </view>

    <view class="panel matches-toolbar">
      <text class="toolbar-label">当前赛事</text>
      <scroll-view class="admin-event-tabs" scroll-x enable-flex show-scrollbar="{{false}}">
        <block wx:for="{{events}}" wx:key="eventId">
          <view
            class="admin-event-tab {{activeEventId === item.eventId ? 'admin-event-tab--active' : ''}}"
            bindtap="handleEventSwitch"
            data-event-id="{{item.eventId}}"
          >
            {{item.eventName}}
          </view>
        </block>
      </scroll-view>
      <view class="toolbar-action" bindtap="openCreateForm">新增比赛</view>
    </view>

    <view wx:if="{{isLoading}}" class="loading-panel panel">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载比赛中...</text>
    </view>

    <view wx:if="{{!isLoading && stageGroups.length}}" class="stage-list">
      <block wx:for="{{stageGroups}}" wx:key="stageName">
        <view class="panel stage-card">
          <text class="stage-title">{{item.stageName}}</text>
          <view class="match-admin-list">
            <block wx:for="{{item.matches}}" wx:key="recordKey">
              <view class="match-admin-item">
                <view class="match-admin-item__head">
                  <text class="match-admin-item__teams">{{item.homeTeam}} vs {{item.awayTeam}}</text>
                  <view class="match-admin-item__edit" bindtap="openEditForm" data-match-id="{{item.matchId}}" data-record-id="{{item._id}}">
                    编辑
                  </view>
                </view>
                <text class="match-admin-item__meta">编号：{{item.matchId}}</text>
                <text class="match-admin-item__meta">时间：{{item.matchTime}}</text>
                <text class="match-admin-item__meta">地点：{{item.location}}</text>
                <text class="match-admin-item__meta">状态：{{item.status}}</text>
              </view>
            </block>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{!isLoading && !stageGroups.length}}" class="empty-state panel">当前赛事还没有比赛数据。</view>
  </view>
</scroll-view>

<view wx:if="{{showEventEditor}}" class="editor-mask" bindtap="closeEventEditor">
  <view class="editor-sheet" catchtap="noop">
    <view class="editor-form-shell">
      <view class="editor-sheet__handle"></view>
      <scroll-view class="editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="editor-head">
          <text class="section-title">{{eventEditorTitle}}</text>
          <text class="section-subtitle">这里管理赛事本身的信息，保存后会同步影响首页、赛程、积分榜和数据榜的赛事列表。</text>
        </view>

        <view class="form-grid">
          <view class="form-field">
            <text class="form-label">赛事编号</text>
            <input class="form-input" value="{{eventFormData.eventId}}" data-field="eventId" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="例如 2026-summer-cup" />
          </view>

          <view class="form-field">
            <text class="form-label">赛事简称</text>
            <input class="form-input" value="{{eventFormData.eventName}}" data-field="eventName" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="例如 2026夏季杯" />
          </view>

          <view class="form-field">
            <text class="form-label">赛事全称</text>
            <input class="form-input" value="{{eventFormData.fullName}}" data-field="fullName" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="请输入完整赛事名称" />
          </view>

          <view class="form-field">
            <text class="form-label">赛季</text>
            <input class="form-input" value="{{eventFormData.season}}" data-field="season" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="例如 2026" />
          </view>

          <view class="form-field">
            <text class="form-label">赛事类型</text>
            <picker mode="selector" range="{{eventTypeOptions}}" range-key="label" value="{{eventTypeIndex}}" bindchange="handleEventTypeChange">
              <view class="form-input form-input--picker">
                <text class="form-input__text">{{eventTypeOptions[eventTypeIndex].label}}</text>
                <text class="form-input__arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="form-field">
            <text class="form-label">赛事状态</text>
            <picker mode="selector" range="{{eventStatusOptions}}" range-key="label" value="{{eventStatusIndex}}" bindchange="handleEventStatusChange">
              <view class="form-input form-input--picker">
                <text class="form-input__text">{{eventStatusOptions[eventStatusIndex].label}}</text>
                <text class="form-input__arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="form-field" wx:if="{{eventFormData.eventType === 'cup'}}">
            <text class="form-label">杯赛展示优先</text>
            <picker mode="selector" range="{{cupDisplayModeOptions}}" range-key="label" value="{{eventDisplayModeIndex}}" bindchange="handleEventDisplayModeChange">
              <view class="form-input form-input--picker">
                <text class="form-input__text">{{cupDisplayModeOptions[eventDisplayModeIndex].label}}</text>
                <text class="form-input__arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="form-field">
            <text class="form-label">排序值</text>
            <input class="form-input" type="number" value="{{eventFormData.sortOrder}}" data-field="sortOrder" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="数字越小越靠前" />
          </view>
        </view>

        <view class="form-field">
          <text class="form-label">赛事简介</text>
          <textarea class="form-textarea form-textarea--compact" value="{{eventFormData.description}}" data-field="description" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="请输入赛事简介"></textarea>
        </view>

        <view class="form-field">
          <text class="form-label">封面图地址</text>
          <input class="form-input" value="{{eventFormData.coverImage}}" data-field="coverImage" bindinput="handleEventFieldInput" bindblur="handleEventFieldInput" placeholder="例如 /assets/covers/cup-cover.svg" />
        </view>
      </scroll-view>

      <view class="editor-actions">
        <view class="editor-btn editor-btn--ghost" bindtap="closeEventEditor">取消</view>
        <view class="editor-btn editor-btn--primary" bindtap="handleSaveEventTap">{{isSavingEvent ? '保存中...' : '保存赛事'}}</view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showEditor}}" class="editor-mask" bindtap="closeEditor">
  <view class="editor-sheet" catchtap="noop">
    <view class="editor-form-shell">
      <view class="editor-sheet__handle"></view>
      <scroll-view class="editor-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="editor-head">
          <text class="section-title">{{editorTitle}}</text>
          <text class="section-subtitle">建议先把比赛建好，再从新闻列表中选择对应战报。</text>
        </view>

        <view class="form-grid">
          <view class="form-field">
            <text class="form-label">比赛编号</text>
            <input class="form-input" value="{{formData.matchId}}" data-field="matchId" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="例如 spring-r01-01" />
          </view>

          <view class="form-field">
            <text class="form-label">比赛轮次 / 阶段</text>
            <input class="form-input" value="{{formData.stage}}" data-field="stage" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="例如 第1轮 / 半决赛" />
            <view wx:if="{{currentEvent && currentEvent.eventType === 'cup'}}" class="stage-preset-wrap">
              <text class="field-tip">杯赛可直接点选阶段，进入淘汰赛后不用再填小组名称。</text>
              <view class="stage-preset-list">
                <block wx:for="{{cupStagePresets}}" wx:key="value">
                  <view
                    class="stage-preset {{formData.stage === item.value ? 'stage-preset--active' : ''}}"
                    bindtap="applyCupStagePreset"
                    data-stage="{{item.value}}"
                  >
                    {{item.label}}
                  </view>
                </block>
              </view>
            </view>
          </view>

          <view class="form-field">
            <text class="form-label">小组名称</text>
            <input class="form-input" value="{{formData.groupName}}" data-field="groupName" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="{{currentEvent && currentEvent.eventType === 'cup' ? '小组赛填 A组 / B组，淘汰赛可留空' : '可留空'}}" />
          </view>

          <view class="form-field">
            <text class="form-label">比赛状态</text>
            <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="handleStatusChange">
              <view class="form-input form-input--picker">
                <text class="form-input__text">{{statusOptions[statusIndex].label}}</text>
                <text class="form-input__arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="form-field">
            <text class="form-label">主队</text>
            <input class="form-input" value="{{formData.homeTeam}}" data-field="homeTeam" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="请输入主队名称" />
          </view>

          <view class="form-field">
            <text class="form-label">客队</text>
            <input class="form-input" value="{{formData.awayTeam}}" data-field="awayTeam" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="请输入客队名称" />
          </view>

          <view class="form-field">
            <text class="form-label">主队比分</text>
            <input class="form-input" type="number" value="{{formData.homeScore}}" data-field="homeScore" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="未开始可留空" />
          </view>

          <view class="form-field">
            <text class="form-label">客队比分</text>
            <input class="form-input" type="number" value="{{formData.awayScore}}" data-field="awayScore" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="未开始可留空" />
          </view>

          <view class="form-field">
            <text class="form-label">比赛时间</text>
            <input class="form-input" value="{{formData.matchTime}}" data-field="matchTime" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="例如 2026-08-01 16:00" />
          </view>

          <view class="form-field">
            <text class="form-label">比赛地点</text>
            <input class="form-input" value="{{formData.location}}" data-field="location" bindinput="handleFieldInput" bindblur="handleFieldInput" placeholder="请输入比赛地点" />
          </view>
        </view>

        <view class="form-field">
          <text class="form-label">关联新闻</text>
          <picker mode="selector" range="{{newsOptions}}" range-key="title" value="{{newsOptionIndex}}" bindchange="handleRelatedNewsChange">
            <view class="form-input form-input--picker">
              <text class="form-input__text">{{newsOptions[newsOptionIndex].title}}</text>
              <text class="form-input__arrow">▾</text>
            </view>
          </picker>
          <text class="picker-detail">{{newsOptions[newsOptionIndex].detail}}</text>
        </view>

        <view class="form-field">
          <text class="form-label">关联新闻标题</text>
          <view class="form-readonly">{{formData.reportTitle || '未关联新闻'}}</view>
        </view>

        <view class="form-field">
          <text class="form-label">进球球员</text>
          <text class="field-tip">每行一条，格式：球员，球队，分钟</text>
          <view class="form-actions">
            <view class="mini-action" bindtap="fillScorersExample">填入示例</view>
            <view class="mini-action mini-action--ghost" bindtap="clearScorersText">清空输入框</view>
          </view>
          <textarea
            class="form-textarea form-textarea--compact"
            value="{{formData.scorersText}}"
            data-field="scorersText"
            bindinput="handleFieldInput"
            bindblur="handleFieldInput"
            placeholder="例如：&#10;张三，经管学院，28&#10;李四，机械学院，64"
          ></textarea>
        </view>

        <view class="form-field">
          <text class="form-label">简短战报</text>
          <textarea
            class="form-textarea"
            value="{{formData.report}}"
            data-field="report"
            bindinput="handleFieldInput"
            bindblur="handleFieldInput"
            placeholder="请输入比赛简短战报"
          ></textarea>
        </view>
      </scroll-view>

      <view class="editor-actions">
        <view class="editor-btn editor-btn--ghost" bindtap="closeEditor">取消</view>
        <view class="editor-btn editor-btn--primary" bindtap="handleSaveTap">{{isSaving ? '保存中...' : '保存比赛'}}</view>
      </view>
    </view>
  </view>
</view>
