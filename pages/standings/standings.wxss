.ranking-summary {
  margin-bottom: 24rpx;
  padding: 24rpx;
}

.ranking-summary__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.ranking-summary__badge {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.cup-mode-tip {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(13, 95, 212, 0.08);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.ranking-panel {
  padding: 24rpx;
}

.group-panel--spaced,
.knockout-stage--spaced {
  margin-top: 24rpx;
}

.group-panel__title,
.knockout-stage__title {
  margin-bottom: 14rpx;
  color: var(--theme-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.ranking-head {
  margin-bottom: 18rpx;
}

.table {
  overflow: hidden;
  border-radius: 20rpx;
  border: 1rpx solid rgba(13, 95, 212, 0.08);
}

.table__row {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 12rpx;
  background: #ffffff;
}

.table__row + .table__row {
  border-top: 1rpx solid #edf2f7;
}

.table__row--head {
  background: #f3f8ff;
  color: var(--theme-text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.table__row--gold {
  background: rgba(243, 192, 77, 0.12);
}

.table__row--silver {
  background: rgba(213, 220, 235, 0.26);
}

.table__row--bronze {
  background: rgba(215, 160, 125, 0.12);
}

.table__cell {
  width: 56rpx;
  text-align: center;
  font-size: 22rpx;
}

.table__cell--rank {
  width: 72rpx;
  font-weight: 700;
}

.table__cell--team {
  flex: 1;
  min-width: 0;
  text-align: left;
  padding: 0 12rpx;
}

.table__cell--wide {
  width: 92rpx;
}

.table__cell--points {
  color: var(--theme-primary);
  font-weight: 700;
}

.knockout-match {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f9fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.08);
}

.knockout-match + .knockout-match {
  margin-top: 16rpx;
}

.knockout-match__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.knockout-match__group {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 20rpx;
}

.knockout-match__time {
  color: var(--theme-text-secondary);
  font-size: 22rpx;
}

.knockout-match__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.knockout-match__team {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--theme-text-primary);
}

.knockout-match__team--right {
  text-align: right;
}

.knockout-match__score {
  flex: none;
  min-width: 110rpx;
  text-align: center;
  color: var(--theme-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.knockout-match__location {
  margin-top: 14rpx;
  color: var(--theme-text-secondary);
  font-size: 22rpx;
}
