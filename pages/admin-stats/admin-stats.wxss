.admin-shell {
  padding-bottom: 48rpx;
}

.stats-toolbar {
  padding: 24rpx;
}

.toolbar-label {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.admin-event-tabs {
  margin-top: 14rpx;
  white-space: nowrap;
  height: 78rpx;
  width: 100%;
}

.admin-event-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 74rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.08);
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  vertical-align: top;
  flex-shrink: 0;
}

.admin-event-tab--active {
  background: var(--theme-primary);
  color: #ffffff;
}

.stats-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.stat-type-panel {
  padding: 24rpx;
}

.stat-type-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.stat-type-tab {
  min-width: 140rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 95, 212, 0.08);
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.stat-type-tab--active {
  background: var(--theme-primary);
  color: #ffffff;
}

.toolbar-action {
  height: 84rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.stat-preview-card {
  padding: 28rpx;
}

.stat-preview-card__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.stat-preview-card__unit {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.08);
  color: var(--theme-primary);
  font-size: 22rpx;
}

.stat-preview-list {
  margin-top: 20rpx;
}

.stat-preview-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(13, 95, 212, 0.08);
}

.stat-preview-row:last-child {
  border-bottom: none;
}

.stat-preview-rank {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #eef4fb;
  color: var(--theme-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.stat-preview-rank--top {
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
}

.stat-preview-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stat-preview-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.stat-preview-team {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.stat-preview-value {
  flex: none;
  min-width: 56rpx;
  text-align: right;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--theme-primary);
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(9, 32, 61, 0.45);
  display: flex;
  align-items: flex-end;
  width: 100vw;
  max-width: 100vw;
}

.editor-sheet {
  width: 100%;
  max-width: 100vw;
  height: 82vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.editor-form-shell {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.editor-sheet__handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d8e3f2;
  flex: none;
}

.editor-scroll {
  flex: 1;
  min-height: 0;
}

.editor-head {
  margin-bottom: 18rpx;
}

.form-actions {
  display: flex;
  gap: 14rpx;
}

.mini-action {
  flex: 1;
  min-height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.mini-action--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}

.form-field {
  margin-top: 18rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.form-textarea {
  width: 100%;
  margin-top: 12rpx;
  min-height: 200rpx;
  height: auto;
  padding: 20rpx;
  line-height: 1.7;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  color: var(--theme-text);
  box-sizing: border-box;
}

.form-textarea--large {
  min-height: 520rpx;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.editor-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.editor-btn--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}

.editor-btn--primary {
  background: var(--theme-primary);
  color: #ffffff;
}
