.page-intro {
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.page-intro__head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
}

.page-intro__badge {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.stage-section + .stage-section {
  margin-top: 28rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.match-card {
  padding: 24rpx;
}

.match-card__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 84rpx;
}

.match-card__team {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.match-card__team--right {
  text-align: right;
}

.match-card__score {
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 999rpx;
  background: #eef3f9;
  color: var(--theme-text-secondary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  flex: none;
}

.match-card__score--done {
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
}

.match-card__meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}
