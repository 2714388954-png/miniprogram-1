.page-intro {
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.page-intro__head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: center;
}

.page-intro__badge {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.page-intro__stats {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.page-intro__stat {
  flex: 1;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: #f8fbff;
}

.page-intro__value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--theme-primary-deep);
}

.page-intro__label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.stage-section + .stage-section {
  margin-top: 28rpx;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.match-card {
  padding: 24rpx;
}

.match-card__teams {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.match-card__team {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
}

.match-card__team--right {
  text-align: right;
}

.match-card__score {
  min-width: 120rpx;
  text-align: center;
  padding: 12rpx 14rpx;
  border-radius: 999rpx;
  background: #eef3f9;
  color: var(--theme-text-secondary);
  font-size: 26rpx;
  font-weight: 700;
}

.match-card__score--done {
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
}

.match-card__meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}
