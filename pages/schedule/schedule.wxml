<app-nav-bar title="赛程赛果" back="{{false}}" color="#15314b" background="transparent"></app-nav-bar>
<scroll-view class="page-scroll" scroll-y>
  <view class="app-page">
    <view class="page-shell schedule-shell">
      <scroll-view class="event-tabs" scroll-x enable-flex show-scrollbar="{{false}}">
        <block wx:for="{{events}}" wx:key="eventId">
          <view
            class="event-tab {{activeEventId === item.eventId ? 'event-tab--active' : ''}}"
            bindtap="handleEventSwitch"
            data-event-id="{{item.eventId}}"
          >
            {{item.eventName}}
          </view>
        </block>
      </scroll-view>

      <view wx:if="{{isLoading}}" class="loading-panel panel">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载赛程中...</text>
      </view>

      <block wx:if="{{!isLoading}}" wx:for="{{stageGroups}}" wx:key="stageName">
        <view class="stage-section">
          <view class="stage-heading">
            <text class="section-title">{{item.stageName}}</text>
          </view>
          <view class="match-list">
            <block wx:for="{{item.matches}}" wx:key="recordKey">
              <view class="match-card panel" bindtap="handleMatchOpen" data-match-id="{{item.matchId}}" data-record-id="{{item._id}}">
                <view class="match-card__teams">
                  <text class="match-card__team">{{item.homeTeam}}</text>
                  <text class="match-card__score {{item.status === 'finished' ? 'match-card__score--done' : ''}}">
                    {{item.status === 'finished' ? item.homeScore + ' : ' + item.awayScore : 'VS'}}
                  </text>
                  <text class="match-card__team match-card__team--right">{{item.awayTeam}}</text>
                </view>
                <view class="match-card__meta">
                  <text>{{item.matchTime}}</text>
                  <text>{{item.location}}</text>
                </view>
              </view>
            </block>
          </view>
        </view>
      </block>

      <view wx:if="{{!isLoading && !stageGroups.length}}" class="empty-state panel">当前赛事还没有录入赛程赛果。</view>
    </view>
    <bottom-tab-bar current="schedule"></bottom-tab-bar>
  </view>
</scroll-view>

<view wx:if="{{showMatchDetail && selectedMatch}}" class="match-detail-mask" bindtap="handleMatchClose">
  <view class="match-detail-sheet" catchtap="stopOverlayScroll">
    <view class="match-detail-sheet__handle"></view>

    <scroll-view class="match-detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="match-detail-sheet__head">
        <view class="match-detail-sheet__stage">{{selectedMatch.stage}}</view>
        <view class="match-detail-sheet__title">比赛详情</view>
      </view>

      <view class="match-detail-score">
        <view class="match-detail-score__team">{{selectedMatch.homeTeam}}</view>
        <view class="match-detail-score__center">
          <view class="match-detail-score__value {{selectedMatch.status === 'finished' ? 'match-detail-score__value--done' : ''}}">
            {{selectedMatch.status === 'finished' ? selectedMatch.homeScore + ' : ' + selectedMatch.awayScore : 'VS'}}
          </view>
          <view class="match-detail-score__meta">{{selectedMatch.matchTime}} · {{selectedMatch.location}}</view>
        </view>
        <view class="match-detail-score__team match-detail-score__team--right">{{selectedMatch.awayTeam}}</view>
      </view>

      <view class="match-detail-block">
        <view class="match-detail-block__title">进球球员</view>
        <block wx:if="{{selectedMatch.scorers.length}}">
          <block wx:for="{{selectedMatch.scorers}}" wx:key="player">
            <view class="match-detail-scorer">
              <view class="match-detail-scorer__minute">{{item.minute}}</view>
              <view class="match-detail-scorer__main">
                <view class="match-detail-scorer__player">{{item.player}}</view>
                <view class="match-detail-scorer__team">{{item.team}}</view>
              </view>
            </view>
          </block>
        </block>
        <view wx:else class="match-detail-empty">本场比赛暂无进球记录。</view>
      </view>

      <view class="match-detail-block">
        <view class="match-detail-block__title">比赛战报</view>
        <view class="match-detail-report">{{selectedMatch.report}}</view>
        <view wx:if="{{selectedMatch.reportNewsId}}" class="match-detail-report-link" bindtap="handleReportOpen">
          <view class="match-detail-report-link__label">查看完整战报</view>
          <view class="match-detail-report-link__title">{{selectedMatch.reportTitle}}</view>
        </view>
      </view>
    </scroll-view>

    <view class="match-detail-actions">
      <view class="match-detail-close" bindtap="handleMatchClose">关闭</view>
    </view>
  </view>
</view>
