.admin-page {
  padding-bottom: 48rpx;
}

.admin-card {
  padding: 28rpx;
}

.admin-card + .admin-card {
  margin-top: 24rpx;
}

.admin-card__head {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-field {
  margin-top: 22rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.form-input {
  width: 100%;
  margin-top: 12rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  color: var(--theme-text);
}

.primary-btn,
.secondary-btn {
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn {
  background: var(--theme-primary);
  color: #ffffff;
}

.secondary-btn {
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
}

.notice-text {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--theme-text-secondary);
}
