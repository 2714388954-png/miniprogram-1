.admin-shell {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.standings-toolbar {
  padding: 24rpx;
}

.toolbar-label {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.admin-event-tabs {
  margin-top: 14rpx;
  white-space: nowrap;
  height: 78rpx;
  width: 100%;
}

.admin-event-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 74rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.08);
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  vertical-align: top;
  flex-shrink: 0;
}

.admin-event-tab--active {
  background: var(--theme-primary);
  color: #ffffff;
}

.display-mode-panel {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.08);
}

.display-mode-panel__head {
  margin-bottom: 16rpx;
}

.display-mode-panel__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.display-mode-panel__desc,
.display-mode-panel__saving {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.display-mode-options {
  display: flex;
  gap: 16rpx;
}

.display-mode-option {
  flex: 1;
  min-height: 120rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(13, 95, 212, 0.12);
  box-sizing: border-box;
}

.display-mode-option--active {
  background: rgba(13, 95, 212, 0.1);
  border-color: rgba(13, 95, 212, 0.28);
}

.display-mode-option__label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--theme-primary);
}

.display-mode-option__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.toolbar-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.toolbar-action {
  flex: 1;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.toolbar-action--secondary {
  background: #eef4fb;
  color: var(--theme-primary);
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.record-card {
  padding: 28rpx;
}

.record-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.record-card__main {
  flex: 1;
}

.record-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.record-card__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.record-card__edit {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.record-card__preview {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.record-card__team {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--theme-text);
}

.knockout-admin-panel {
  margin-top: 24rpx;
  padding: 24rpx;
}

.knockout-admin-panel__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.knockout-admin-panel__main {
  flex: 1;
}

.knockout-admin-panel__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.knockout-admin-panel__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
  line-height: 1.6;
}

.knockout-admin-panel__action {
  flex: none;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.knockout-admin-list {
  margin-top: 20rpx;
}

.knockout-admin-stage + .knockout-admin-stage {
  margin-top: 20rpx;
}

.knockout-admin-stage__title {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--theme-primary);
}

.knockout-admin-match {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.08);
}

.knockout-admin-match + .knockout-admin-match {
  margin-top: 14rpx;
}

.knockout-admin-match__line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.knockout-admin-match__team {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--theme-text);
}

.knockout-admin-match__team--right {
  text-align: right;
}

.knockout-admin-match__score {
  flex: none;
  min-width: 110rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--theme-primary);
}

.knockout-admin-match__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.knockout-admin-match__edit {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(9, 32, 61, 0.45);
  display: flex;
  align-items: flex-end;
  width: 100vw;
  max-width: 100vw;
}

.editor-sheet {
  width: 100%;
  max-width: 100vw;
  height: 84vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.editor-form-shell {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.editor-sheet__handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d8e3f2;
  flex: none;
}

.editor-scroll {
  flex: 1;
  min-height: 0;
}

.editor-head {
  margin-bottom: 18rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.form-field {
  margin-top: 18rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 12rpx;
  min-height: 84rpx;
  height: 84rpx;
  padding: 0 20rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  color: var(--theme-text);
  box-sizing: border-box;
}

.form-input--picker {
  display: flex;
  align-items: center;
}

.form-textarea {
  min-height: 240rpx;
  height: auto;
  padding: 20rpx;
  line-height: 1.7;
}

.form-textarea--large {
  min-height: 520rpx;
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.editor-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.editor-btn--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}

.editor-btn--danger {
  background: rgba(217, 48, 37, 0.12);
  color: #c5221f;
}

.editor-btn--primary {
  background: var(--theme-primary);
  color: #ffffff;
}

.field-tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.form-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.mini-action {
  flex: 1;
  min-height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.mini-action--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}
