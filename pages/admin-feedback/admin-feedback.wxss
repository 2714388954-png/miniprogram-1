.admin-page {
  padding-bottom: 48rpx;
}

.feedback-card,
.feedback-item {
  padding: 28rpx;
}

.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-field {
  margin-top: 22rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 12rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  color: var(--theme-text);
  box-sizing: border-box;
}

.form-textarea {
  min-height: 360rpx;
  height: 360rpx;
  line-height: 1.7;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.primary-btn {
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-item__time,
.feedback-item__name,
.feedback-item__contact,
.feedback-item__content {
  display: block;
}

.feedback-item__time {
  font-size: 22rpx;
  color: var(--theme-text-secondary);
}

.feedback-item__name {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.feedback-item__contact {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.feedback-item__content {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--theme-text);
}
