.detail-page {
  padding-bottom: 48rpx;
}

.detail-header {
  padding: 24rpx 0 18rpx;
}

.detail-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.45;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.detail-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-size: 22rpx;
}

.detail-time {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.detail-cover {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.detail-body {
  margin-top: 24rpx;
  padding: 28rpx;
}

.detail-content {
  font-size: 28rpx;
  line-height: 1.9;
  color: var(--theme-text);
}
