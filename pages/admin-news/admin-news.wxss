.admin-shell {
  padding-bottom: 48rpx;
}

.news-toolbar {
  padding: 24rpx;
}

.toolbar-label {
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.admin-event-tabs {
  margin-top: 14rpx;
  white-space: nowrap;
  height: 78rpx;
  width: 100%;
}

.admin-event-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  height: 74rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.08);
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  vertical-align: top;
  flex-shrink: 0;
}

.admin-event-tab--active {
  background: var(--theme-primary);
  color: #ffffff;
}

.toolbar-action {
  height: 84rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.news-admin-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.news-admin-card {
  padding: 28rpx;
}

.news-admin-card__head {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
  align-items: flex-start;
}

.news-admin-card__main {
  flex: 1;
  min-width: 0;
}

.news-admin-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--theme-text);
  line-height: 1.5;
}

.news-admin-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.news-admin-card__tag,
.news-admin-card__badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
}

.news-admin-card__tag {
  background: rgba(13, 95, 212, 0.08);
  color: var(--theme-primary);
}

.news-admin-card__badge {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}

.news-admin-card__badge--strong {
  background: rgba(13, 95, 212, 0.14);
  color: var(--theme-primary);
}

.news-admin-card__edit {
  flex: none;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(13, 95, 212, 0.12);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 700;
}

.news-admin-card__summary {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: var(--theme-text);
}

.news-admin-card__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.editor-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(9, 32, 61, 0.45);
  display: flex;
  align-items: flex-end;
  width: 100vw;
  max-width: 100vw;
}

.editor-sheet {
  width: 100%;
  max-width: 100vw;
  height: 84vh;
  padding: 28rpx 28rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.editor-form-shell {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  width: 100%;
}

.editor-sheet__handle {
  width: 84rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d8e3f2;
  flex: none;
}

.editor-scroll {
  flex: 1;
  min-height: 0;
}

.editor-head {
  margin-bottom: 18rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.form-field {
  margin-top: 18rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: var(--theme-text-secondary);
}

.form-input,
.form-textarea {
  width: 100%;
  margin-top: 12rpx;
  min-height: 84rpx;
  height: 84rpx;
  padding: 0 20rpx;
  line-height: 84rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.1);
  font-size: 28rpx;
  color: var(--theme-text);
  box-sizing: border-box;
}

.form-textarea {
  min-height: 200rpx;
  height: auto;
  padding: 20rpx;
  line-height: 1.7;
}

.form-textarea--compact {
  min-height: 160rpx;
}

.form-textarea--large {
  min-height: 360rpx;
}

.cover-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.cover-action {
  flex: 1;
  min-height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef4fb;
  color: var(--theme-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.cover-action--primary {
  background: rgba(13, 95, 212, 0.1);
  color: var(--theme-primary);
}

.switch-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 18rpx;
}

.switch-card {
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(13, 95, 212, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.switch-card__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--theme-text);
}

.editor-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.editor-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.editor-btn--ghost {
  background: #eef4fb;
  color: var(--theme-text-secondary);
}

.editor-btn--danger {
  background: rgba(217, 48, 37, 0.12);
  color: #c5221f;
}

.editor-btn--primary {
  background: var(--theme-primary);
  color: #ffffff;
}
