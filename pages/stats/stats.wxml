<app-nav-bar title="数据榜" back="{{false}}" color="#15314b" background="transparent"></app-nav-bar>
<scroll-view class="page-scroll" scroll-y>
  <view class="app-page">
    <view class="page-shell">
      <view class="event-filter-row">
        <view class="event-filter-card">
          <text class="event-filter-card__label">当前赛事</text>
          <picker
            mode="selector"
            range="{{currentEvents}}"
            range-key="eventName"
            value="{{currentEventIndex}}"
            bindchange="handleCurrentEventChange"
            disabled="{{!currentEvents.length}}"
          >
            <view class="event-filter-card__picker {{!currentEvents.length ? 'event-filter-card__picker--disabled' : ''}}">
              <text class="event-filter-card__value">{{currentEvents.length ? currentEvents[currentEventIndex].eventName : '暂无赛事'}}</text>
              <text class="event-filter-card__arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="event-filter-card">
          <text class="event-filter-card__label">历史赛事</text>
          <picker
            mode="selector"
            range="{{historyEvents}}"
            range-key="eventName"
            value="{{historyEventIndex}}"
            bindchange="handleHistoryEventChange"
            disabled="{{!historyEvents.length}}"
          >
            <view class="event-filter-card__picker {{!historyEvents.length ? 'event-filter-card__picker--disabled' : ''}}">
              <text class="event-filter-card__value">{{historyEvents.length ? historyEvents[historyEventIndex].eventName : '暂无历史赛事'}}</text>
              <text class="event-filter-card__arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>

      <view wx:if="{{isLoading}}" class="loading-panel panel">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载榜单中...</text>
      </view>

      <view wx:if="{{!isLoading}}" class="segmented">
        <block wx:for="{{statTabs}}" wx:key="key">
          <view
            class="segmented__item {{activeStatKey === item.key ? 'segmented__item--active' : ''}}"
            bindtap="handleStatSwitch"
            data-stat-key="{{item.key}}"
          >
            {{item.label}}
          </view>
        </block>
      </view>

      <view wx:if="{{!isLoading}}" class="stats-panel panel">
        <view class="stats-table-head">
          <view class="stats-table-head__name">球员</view>
          <view class="stats-table-head__team">学院</view>
          <view class="stats-table-head__value">{{statColumnLabel}}</view>
        </view>
        <block wx:if="{{statRows.length}}">
          <block wx:for="{{statRows}}" wx:key="playerId">
            <view
              class="stats-row {{item.rank === 1 ? 'stats-row--gold' : ''}} {{item.rank === 2 ? 'stats-row--silver' : ''}} {{item.rank === 3 ? 'stats-row--bronze' : ''}}"
            >
              <view class="stats-row__name-col">
                <text class="stats-row__name">{{item.rank}}. {{item.playerName}}</text>
              </view>
              <view class="stats-row__team-col">
                <text class="stats-row__team">{{item.teamName}}</text>
              </view>
              <view class="stats-row__value-col">
                <view class="stats-row__value">{{item.value}}{{statUnit}}</view>
              </view>
            </view>
          </block>
        </block>
        <view wx:else class="empty-state">当前榜单暂时还没有数据。</view>
      </view>
    </view>
    <bottom-tab-bar current="stats"></bottom-tab-bar>
  </view>
</scroll-view>
