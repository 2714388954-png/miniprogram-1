<app-nav-bar title="重大足协赛事" back="{{false}}" color="#15314b" background="transparent"></app-nav-bar>
<scroll-view class="page-scroll" scroll-y>
  <view class="app-page">
    <view class="page-shell">
      <view class="page-top-actions">
        <view class="admin-entry" bindtap="openAdminEntry">管理员入口</view>
        <picker mode="selector" range="{{filterOptions}}" range-key="label" value="{{activeFilterIndex}}" bindchange="handleFilterChange">
          <view class="home-filter-picker">
            <text class="home-filter-picker__text">{{filterOptions.length ? filterOptions[activeFilterIndex].label : '全部'}}</text>
            <text class="home-filter-picker__arrow">▾</text>
          </view>
        </picker>
        <image class="home-badge" src="/assets/club-badge.png" mode="aspectFit"></image>
      </view>

      <view wx:if="{{isLoading}}" class="loading-panel panel">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <view wx:if="{{!isLoading}}" class="hero panel">
        <view class="hero__meta">
          <text class="hero__eyebrow">重庆大学学生足球协会</text>
          <view class="hero__title-row">
            <text class="hero__title">足协新闻</text>
          </view>
          <text class="hero__desc">首页统一展示全部新闻，可按赛事类型或普通新闻筛选查看。</text>
        </view>

        <block wx:if="{{featuredNews.length}}">
          <swiper class="hero__swiper" indicator-dots autoplay circular interval="4500">
            <block wx:for="{{featuredNews}}" wx:key="newsId">
              <swiper-item>
                <view class="hero__slide" bindtap="openNewsDetail" data-news-id="{{item.newsId}}">
                  <image class="hero__image" src="{{item.coverImage}}" mode="aspectFill"></image>
                  <view class="hero__overlay">
                    <text class="hero__tag">{{item.displayTag}}</text>
                    <text class="hero__headline">{{item.title}}</text>
                    <text class="hero__summary">{{item.summary}}</text>
                  </view>
                </view>
              </swiper-item>
            </block>
          </swiper>
        </block>
        <view wx:else class="empty-state">当前还没有焦点新闻。</view>
      </view>

      <view wx:if="{{!isLoading}}" class="section">
        <view wx:if="{{newsList.length}}" class="news-list">
          <block wx:for="{{newsList}}" wx:key="newsId">
            <view class="news-card panel" bindtap="openNewsDetail" data-news-id="{{item.newsId}}">
              <image class="news-card__image" src="{{item.coverImage}}" mode="aspectFill"></image>
              <view class="news-card__content">
                <view class="news-card__topline">
                  <view class="news-card__tags">
                    <text class="news-card__tag">{{item.displayTag}}</text>
                    <text wx:if="{{item.isPinned}}" class="news-card__pin">置顶</text>
                  </view>
                  <text class="news-card__time">{{item.publishTime}}</text>
                </view>
                <text class="news-card__title">{{item.title}}</text>
                <text class="news-card__summary">{{item.summary}}</text>
              </view>
            </view>
          </block>
        </view>
        <view wx:else class="empty-state panel">当前筛选条件下还没有新闻内容。</view>
      </view>
    </view>
    <bottom-tab-bar current="home"></bottom-tab-bar>
  </view>
</scroll-view>
